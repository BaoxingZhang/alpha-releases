{
  "name": "alpha-recovered-local",
  "version": "0.3.5",
  "private": true,
  "description": "Editable recovered Alpha JavaScript plus original macOS arm64 runtime artifacts",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "index": "node tools/index-recovered-code.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "setup": "node node_modules/electron/install.js && node node_modules/esbuild/install.js",
    "extract:protocol": "node tools/extract-protocol.mjs",
    "verify:protocol": "node tools/extract-protocol.mjs --check",
    "test:protocol": "node --test tests/protocol.test.mjs",
    "build:bridge": "node scripts/build-data-bridge.mjs",
    "build:snapshot-import": "node scripts/build-snapshot-import.mjs",
    "build:independent": "npm run build:bridge && npm run build:snapshot-import && node scripts/build.mjs --independent",
    "build:packaged": "npm run build:independent && node scripts/build-packaged-resources.mjs",
    "package:macos-app": "npm run build:packaged && node scripts/package-macos-app.mjs",
    "package:macos-app:from-build": "node scripts/package-macos-app.mjs",
    "package:macos-dmg": "npm run build:packaged && node scripts/package-macos-app.mjs --dmg",
    "release:manifest": "node scripts/release-manifest.mjs",
    "bundle:recovery": "node scripts/recovery-bundle.mjs",
    "start:independent": "node scripts/launch.mjs --independent",
    "test:security": "node --test tests/security.test.mjs tests/independent-boundary-security.test.cjs",
    "test:bridge": "node --test tests/data-bridge.test.mjs",
    "test:engine": "node --test tests/engine*.test.mjs",
    "test:independent": "node tests/independent-smoke.mjs",
    "test:encrypted": "node tests/encrypted-smoke.mjs",
    "test:search": "node tests/search-smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:encrypted": "node scripts/demo.mjs --encrypted",
    "demo:search": "node scripts/demo.mjs --search",
    "test:boundaries": "node --test tests/independent-boundary-*.test.*",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "record:maintenance": "node scripts/record-maintenance.mjs",
    "check:project": "node scripts/check-project.mjs",
    "check:maintainability": "node scripts/check-maintainability.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@hicccc77/electron-liquid-glass": "0.4.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.10",
    "@babel/traverse": "8.0.10",
    "electron": "44.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
