{
  "name": "alpha-recovered-local",
  "version": "0.3.5",
  "private": true,
  "description": "Editable recovered Alpha JavaScript plus original macOS arm64 runtime artifacts",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "index": "node tools/index-recovered-code.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "setup": "node node_modules/electron/install.js && node node_modules/esbuild/install.js",
    "extract:protocol": "node tools/extract-protocol.mjs",
    "verify:protocol": "node tools/extract-protocol.mjs --check",
    "test:protocol": "node --test tests/protocol.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@hicccc77/electron-liquid-glass": "0.4.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.10",
    "@babel/traverse": "8.0.10",
    "electron": "44.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
